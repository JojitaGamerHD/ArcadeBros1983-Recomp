+
+    if (x < 1 || s_tex_h < 12)
+        return;
+
+    /* Sombra de un pixel para mantener legibilidad. */
+    arcade_fps_texto(
+        x + 1, y + 1,
+        linea,
+        0, 0, 0
+    );
+
+    /* Texto blanco estilo NES. */
+    arcade_fps_texto(
+        x, y,
+        linea,
+        235, 235, 235
+    );
