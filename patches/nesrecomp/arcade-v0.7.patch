+    Uint8 r, Uint8 g, Uint8 b)
+{
+    SDL_SetRenderDrawColor(s_ren, r, g, b, 255);
+
+    for (const char *p = texto; *p; ++p, x += 4) {
+        const uint8_t *glifo = cyc_overlay_glyph(*p);
+
+        if (!glifo) continue;
+
+        for (int fila = 0; fila < 5; ++fila) {
+            for (int col = 0; col < 3; ++col) {
+                if (glifo[fila] & (4 >> col)) {
+                    SDL_RenderDrawPoint(
