+static const char *const s_deadzone_keys[] = { "cyc.controls.deadzone.1", "cyc.controls.deadzone.2" };
+
+static int *arcade_control_setting(const RecompRuntimeUiItem *it)
+{
+    for (int player = 0; player < 2; ++player) {
+        if (is_key(it, s_source_keys[player])) return &s_host.settings->bind.source[player];
+        if (is_key(it, s_deadzone_keys[player])) return &s_host.settings->bind.deadzone[player];
+    }
+    return NULL;
+}
+
+static void arcade_pause_back(const char *page)
+{
+    add("cyc.arcade.back", page, "Volver", NULL, RECOMP_RUNTIME_UI_ACTION, 0, 0, 0, NULL, 0, NULL);
+}
+
+static void arcade_pause_append(const RecompRuntimeUiItem *items, size_t count,
+                                const char *category, const char *path)
+{
+    for (size_t i = 0; i < count && s_item_count < sizeof(s_items) / sizeof(s_items[0]); ++i) {
+        const char *section = items[i].section;
+        bool match = category ? section && strcmp(section, category) == 0
+            : !section || (strcmp(section, "Audio") != 0 && strcmp(section, "Colores") != 0);
+        if (match) {
+            s_items[s_item_count] = items[i];
+            s_items[s_item_count++].section = path;
+        }
+    }
+}
+
