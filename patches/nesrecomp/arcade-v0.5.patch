+
+    if (x < 0) return;
+
+    SDL_Rect fondo = { x, y, ancho, alto };
+
+    SDL_SetRenderDrawColor(s_ren, 15, 19, 25, 255);
+    SDL_RenderFillRect(s_ren, &fondo);
+
+    arcade_fps_texto(x + 6, y + 4, nes, 150, 240, 150);
+    arcade_fps_texto(x + 6, y + 17, pantalla, 150, 205, 255);
