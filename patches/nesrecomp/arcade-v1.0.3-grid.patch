 }
+
+static void draw_picture_grid(void)
+{
+    enum { NES_WIDTH = 256, NES_HEIGHT = 240 };
+    const int alpha = arcade_grid_alpha(s_set.grid_intensity);
+    if (!alpha || picture_w() != NES_WIDTH || picture_h() != NES_HEIGHT) return;
+
+    /* Draw in output pixels within the existing picture viewport. Its
+     * position and the logical coordinates used for input stay unchanged. */
+    float scale_x, scale_y;
+    SDL_RenderGetScale(s_ren, &scale_x, &scale_y);
+    SDL_RenderSetScale(s_ren, 1.0f, 1.0f);
+    SDL_Rect viewport;
+    SDL_RenderGetViewport(s_ren, &viewport);
+    const int width = viewport.w;
+    const int height = s_bar ? SDL_min(viewport.h, (int)(NES_HEIGHT * scale_y)) : viewport.h;
+    if (arcade_grid_visible(width, height, NES_WIDTH, NES_HEIGHT)) {
+        SDL_Rect lines[NES_WIDTH + NES_HEIGHT - 2];
+        int count = 0;
+        for (int x = 1; x < NES_WIDTH; ++x)
+            lines[count++] = (SDL_Rect){arcade_grid_offset(width, x, NES_WIDTH), 0, 1, height};
+        for (int y = 1; y < NES_HEIGHT; ++y)
+            lines[count++] = (SDL_Rect){0, arcade_grid_offset(height, y, NES_HEIGHT), width, 1};
+        SDL_BlendMode blend;
+        Uint8 r, g, b, a;
+        SDL_GetRenderDrawBlendMode(s_ren, &blend);
+        SDL_GetRenderDrawColor(s_ren, &r, &g, &b, &a);
+        SDL_SetRenderDrawBlendMode(s_ren, SDL_BLENDMODE_BLEND);
+        SDL_SetRenderDrawColor(s_ren, 0, 0, 0, (Uint8)alpha);
+        SDL_RenderFillRects(s_ren, lines, count);
+        SDL_SetRenderDrawColor(s_ren, r, g, b, a);
+        SDL_SetRenderDrawBlendMode(s_ren, blend);
+    }
+    SDL_RenderSetScale(s_ren, scale_x, scale_y);
+}
 #endif
 
