+#ifdef ARCADE_NATIVE_MENU
+static void draw_picture_frame(void)
+{
+    float scale_x, scale_y;
+    SDL_RenderGetScale(s_ren, &scale_x, &scale_y);
+    /* SDL stores the viewport in output pixels but its getter divides by
+     * the current logical scale. Read and restore it at unit scale so a
+     * fractional fit cannot shift the original picture on subsequent draws. */
+    SDL_RenderSetScale(s_ren, 1.0f, 1.0f);
+    SDL_Rect viewport;
+    SDL_RenderGetViewport(s_ren, &viewport);
+    SDL_RenderSetViewport(s_ren, NULL);
+
+    const int edge_x = SDL_max(1, (int)(3.2f * scale_x + 0.5f));
+    const int edge_y = SDL_max(1, (int)(3.0f * scale_y + 0.5f));
+    const int left = viewport.x - edge_x;
+    const int right = viewport.x + viewport.w;
+    const int top = viewport.y - edge_y;
+    const int bottom = viewport.y + viewport.h;
+    const int width = viewport.w + 2 * edge_x;
+    const SDL_Rect strips[] = {
+        { left, top, width, edge_y },
+        { left, bottom, width, edge_y },
+        { left, viewport.y, edge_x, viewport.h },
+        { right, viewport.y, edge_x, viewport.h }
+    };
+    const uint32_t rgb = s_set.frame_rgb;
+    SDL_SetRenderDrawColor(s_ren, (Uint8)(rgb >> 16), (Uint8)(rgb >> 8), (Uint8)rgb, 255);
+    /* The full output viewport clips edges with no letterbox space. */
+    SDL_RenderFillRects(s_ren, strips, (int)SDL_arraysize(strips));
+    SDL_RenderSetViewport(s_ren, &viewport);
+    SDL_RenderSetScale(s_ren, scale_x, scale_y);
+}
+#endif
