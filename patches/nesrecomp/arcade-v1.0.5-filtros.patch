+static bool draw_sharp_picture(const uint32_t *pixels, int w, int h, const SDL_Rect *dest)
+{
+    if (!s_sharp_tex) {
+        s_sharp_tex = SDL_CreateTexture(s_ren, SDL_PIXELFORMAT_ARGB8888,
+                                      SDL_TEXTUREACCESS_STREAMING, w * 2, h * 2);
+        if (!s_sharp_tex) return false;
+        SDL_SetTextureScaleMode(s_sharp_tex, SDL_ScaleModeLinear);
+    }
+    void *expanded;
+    int pitch;
+    if (SDL_LockTexture(s_sharp_tex, NULL, &expanded, &pitch) != 0) return false;
+    arcade_expand_2x(expanded, (size_t)pitch / sizeof(uint32_t), pixels, w, h);
+    SDL_UnlockTexture(s_sharp_tex);
+    return SDL_RenderCopy(s_ren, s_sharp_tex, NULL, dest) == 0;
