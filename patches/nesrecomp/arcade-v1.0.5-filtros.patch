--- /dev/null
+++ b/runner/cyc/cyc_arcade_filter.h
@@ -0,0 +1,78 @@
+#ifndef CYC_ARCADE_FILTER_H
+#define CYC_ARCADE_FILTER_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+/* The first two values are already stored in v1.0.3/v1.0.4 config.ini files. */
+enum {
+    ARCADE_FILTER_NONE,
+    ARCADE_FILTER_GRID,
+    ARCADE_FILTER_SCANLINES,
+    ARCADE_FILTER_CRT,
+    ARCADE_FILTER_SHARP,
+    ARCADE_FILTER_COUNT
+};
+
+#define ARCADE_FILTER_INTENSITY_KEY "cyc.arcade.filter_intensity"
+
+static const char *const arcade_filter_names[ARCADE_FILTER_COUNT] = {
+    "NINGUNO", "GRID", "SCANLINES", "CRT", "NÍTIDO"
+};
+
+static inline int arcade_filter_valid(int filter)
+{
+    return filter >= ARCADE_FILTER_NONE && filter < ARCADE_FILTER_COUNT;
+}
+
+static inline const char *arcade_filter_intensity_name(int filter)
+{
+    switch (filter) {
+    case ARCADE_FILTER_GRID: return "INTENSIDAD DE GRID";
+    case ARCADE_FILTER_SCANLINES: return "INTENSIDAD LÍNEAS";
+    case ARCADE_FILTER_CRT: return "INTENSIDAD CRT";
+    default: return NULL;
+    }
+}
+
+static inline int *arcade_filter_intensity(int filter, int *grid, int *scanlines, int *crt)
+{
+    switch (filter) {
+    case ARCADE_FILTER_GRID: return grid;
+    case ARCADE_FILTER_SCANLINES: return scanlines;
+    case ARCADE_FILTER_CRT: return crt;
+    default: return NULL;
+    }
+}
+
+static inline int arcade_scanline_width(int row_height)
+{
+    return row_height < 6 ? 1 : row_height / 3;
+}
+
+static inline int arcade_crt_mask_gain(int intensity)
+{
+    return 255 - intensity;
+}
+
+static inline int arcade_sharp_fractional(int width, int height, int source_width, int source_height)
+{
+    return width > 0 && height > 0 &&
+           (width % source_width != 0 || height % source_height != 0);
+}
+
+/* Point-expand once, then let the backend interpolate the fractional stretch. */
+static inline void arcade_expand_2x(uint32_t *dest, size_t pitch,
+                                   const uint32_t *source, int width, int height)
+{
+    for (int y = 0; y < height; ++y) {
+        uint32_t *upper = dest + (size_t)y * 2 * pitch;
+        const uint32_t *row = source + (size_t)y * width;
+        for (int x = 0; x < width; ++x)
+            upper[2 * x] = upper[2 * x + 1] = row[x];
+        memcpy(upper + pitch, upper, (size_t)width * 2 * sizeof(*upper));
+    }
+}
+
+#endif
