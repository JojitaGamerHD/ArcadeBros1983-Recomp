diff --git a/src/common/launcher_i18n.cpp b/src/common/launcher_i18n.cpp
index 91a6c97..8885005 100644
--- a/src/common/launcher_i18n.cpp
+++ b/src/common/launcher_i18n.cpp
@@ -205,6 +205,30 @@ static const LauncherI18nEntry kItalian[] = {
     {"No patch selected", "Nessuna patch selezionata"},
 };
 
+/* Traduccion espanola de Arcade Bros 1983 Recomp. */
+static const LauncherI18nEntry kSpanish[] = {
+    {"Settings", u8"Configuración"},
+    {"Credits", u8"Créditos"},
+    {"Display", u8"Pantalla"},
+    {"Graphics", u8"Gráficos"},
+    {"Controls", u8"Controles"},
+    {"System", u8"Sistema"},
+    {"Window scale", u8"Escala de ventana"},
+    {"Fullscreen", u8"Pantalla completa"},
+    {"Integer scaling", u8"Escalado entero"},
+    {"Linear filtering", u8"Filtrado lineal"},
+    {"Resume game", u8"Continuar partida"},
+    {"RESUME", u8"CONTINUAR"},
+    {"QUIT GAME", u8"SALIR DEL JUEGO"},
+    {"Off", u8"Desactivado"},
+    {"On", u8"Activado"},
+    {"Borderless", u8"Sin bordes"},
+    {"Exclusive", u8"Exclusiva"},
+    {"Default", u8"Predeterminado"},
+    {"Reset", u8"Restablecer"},
+    {"Pause", u8"Pausa"},
+};
+
 static const char* lookup(const LauncherI18nEntry* entries, int count,
                           const char* english) {
     if (!english) return "";
@@ -231,5 +255,10 @@ const char* launcher_i18n_text(const char* english) {
         return lookup(kItalian, (int)(sizeof(kItalian) / sizeof(kItalian[0])),
                       english);
     }
+    if (std::strcmp(language, "es") == 0 ||
+        std::strcmp(language, "es-CL") == 0) {
+        return lookup(kSpanish, (int)(sizeof(kSpanish) / sizeof(kSpanish[0])),
+            english);
+    }
     return english ? english : "";
 }
