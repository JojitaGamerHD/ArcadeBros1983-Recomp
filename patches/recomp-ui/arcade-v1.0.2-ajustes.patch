+
+ImU32 arcade_rgb(uint32_t rgb) {
+    return IM_COL32((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, 255);
+}
+
+void draw_arcade_frame(ImDrawList* draw, ImVec2 min, ImVec2 max, ImVec2 inset, uint32_t rgb) {
+    const ImU32 color = arcade_rgb(rgb);
+    draw->AddRectFilled(min, ImVec2(max.x, min.y + inset.y), color);
+    draw->AddRectFilled(ImVec2(min.x, max.y - inset.y), max, color);
+    draw->AddRectFilled(ImVec2(min.x, min.y + inset.y), ImVec2(min.x + inset.x, max.y - inset.y), color);
+    draw->AddRectFilled(ImVec2(max.x - inset.x, min.y + inset.y), ImVec2(max.x, max.y - inset.y), color);
 }
 
