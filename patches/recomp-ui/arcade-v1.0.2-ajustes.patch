diff --git a/src/common/backends/imgui/arcade_color_disc.h b/src/common/backends/imgui/arcade_color_disc.h
new file mode 100644
--- /dev/null
+++ b/src/common/backends/imgui/arcade_color_disc.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include "imgui.h"
+#include <cmath>
+
+inline void paint_color_disc(ImVec2 center,float radius,float hue,float saturation) {
+    constexpr float tau=6.28318530718f;
+    ImDrawList *draw=ImGui::GetWindowDrawList();
+    const ImVec2 uv=ImGui::GetFontTexUvWhitePixel();
+    constexpr int segments=120;
+    draw->PrimReserve(segments*3,segments*3);
+    for (int i=0;i<segments;++i) {
+        const float a=float(i)/segments,b=float(i+1)/segments;
+        float ar,ag,ab,br,bg,bb;
+        ImGui::ColorConvertHSVtoRGB(a,1,1,ar,ag,ab);
+        ImGui::ColorConvertHSVtoRGB(b,1,1,br,bg,bb);
+        const unsigned base=draw->_VtxCurrentIdx;
+        draw->PrimWriteIdx((ImDrawIdx)base); draw->PrimWriteIdx((ImDrawIdx)(base+1)); draw->PrimWriteIdx((ImDrawIdx)(base+2));
+        draw->PrimWriteVtx(center,uv,IM_COL32_WHITE);
+        draw->PrimWriteVtx(ImVec2(center.x+std::cos(a*tau)*radius,center.y+std::sin(a*tau)*radius),uv,
+            ImGui::ColorConvertFloat4ToU32(ImVec4(ar,ag,ab,1)));
+        draw->PrimWriteVtx(ImVec2(center.x+std::cos(b*tau)*radius,center.y+std::sin(b*tau)*radius),uv,
+            ImGui::ColorConvertFloat4ToU32(ImVec4(br,bg,bb,1)));
+    }
+    draw->AddCircle(center,radius,IM_COL32(110,125,145,255),segments,1.0f);
+    const ImVec2 marker(center.x+std::cos(hue*tau)*saturation*radius,
+                        center.y+std::sin(hue*tau)*saturation*radius);
+    draw->AddCircle(marker,6,IM_COL32(0,0,0,255),20,3.0f);
+    draw->AddCircle(marker,5,IM_COL32_WHITE,20,2.0f);
+}
