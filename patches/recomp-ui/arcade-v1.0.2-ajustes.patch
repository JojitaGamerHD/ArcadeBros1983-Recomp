+        paint_color_disc(ImVec2(pos.x + panel * 0.5f, pos.y + diameter * 0.5f),
+            diameter * 0.5f - 4.0f, state.frame_hsv[0], state.frame_hsv[1]);
+        ImGui::Dummy(ImVec2(panel, diameter));
+
+        static const char* const labels[] = {"TONO", "SATURACIÓN", "BRILLO"};
+        bool changed = false;
+        for (int i = 0; i < IM_ARRAYSIZE(labels); ++i) {
+            ImGui::PushID(i);
+            ImGui::TextUnformatted(labels[i]);
+            ImGui::SetNextItemWidth(panel);
+            int value = static_cast<int>(std::round(state.frame_hsv[i] * (i == 0 ? 360 : 100)));
