+#ifdef ARCADE_NATIVE_MENU
+void draw_arcade_demo_grid(ImDrawList* draw, ImVec2 min, ImVec2 max,
+                           int source_width, int source_height, int intensity) {
+    const int alpha = arcade_grid_alpha(intensity);
+    if (!alpha) return;
+    const ImVec2 density = ImGui::GetIO().DisplayFramebufferScale;
+    const int left = static_cast<int>(std::round(min.x * density.x));
+    const int top = static_cast<int>(std::round(min.y * density.y));
+    const int width = static_cast<int>(std::round(max.x * density.x)) - left;
+    const int height = static_cast<int>(std::round(max.y * density.y)) - top;
+    if (!arcade_grid_visible(width, height, source_width, source_height)) return;
+
+    const ImU32 color = IM_COL32(0, 0, 0, alpha);
+    for (int x = 1; x < source_width; ++x) {
+        const int line = left + arcade_grid_offset(width, x, source_width);
+        draw->AddRectFilled(ImVec2(line / density.x, min.y),
+                            ImVec2((line + 1) / density.x, max.y), color);
+    }
+    for (int y = 1; y < source_height; ++y) {
+        const int line = top + arcade_grid_offset(height, y, source_height);
+        draw->AddRectFilled(ImVec2(min.x, line / density.y),
+                            ImVec2(max.x, (line + 1) / density.y), color);
+    }
+}
+#endif
