+int draw_arcade_menu_rows(const ArcadeTitleCanvas& canvas, const char* const* rows,
+                          int count, int& selection, bool& focus_selection,
+                          int white_row = -1, float center_y = 665.0f) {
+    constexpr ImU32 amber = IM_COL32(255, 176, 43, 255);
+    constexpr ImU32 white = IM_COL32(250, 240, 246, 255);
+    const float scale = canvas.scale;
+    // Snap once in framebuffer pixels so later rows can't round differently.
+    const float density = ImGui::GetIO().DisplayFramebufferScale.y;
+    const float pitch = std::max(1.0f, std::round(64.0f * scale * density));
+    const float center = (canvas.origin.y + center_y * scale) * density;
+    const float first = std::round(center - pitch * static_cast<float>(count - 1) * 0.5f);
+    const auto row_y = [=](int row) { return (first + pitch * static_cast<float>(row)) / density; };
+    ImGui::PushStyleColor(ImGuiCol_NavCursor, IM_COL32(0, 0, 0, 0));
+    int activated = -1;
+    int hovered = -1;
+    for (int i = 0; i < count; ++i) {
+        ImGui::SetCursorScreenPos(ImVec2(canvas.point(170, 0).x, row_y(i) - 24 * scale));
+        if (focus_selection && selection == i) ImGui::SetKeyboardFocusHere();
+        if (ImGui::InvisibleButton(rows[i], ImVec2(620 * scale, 48 * scale),
+                                   ImGuiButtonFlags_EnableNav))
+            activated = i;
+        if (ImGui::IsItemFocused()) selection = i;
+        if (ImGui::IsItemHovered()) hovered = i;
+        canvas.text_at(rows[i], ImVec2(canvas.point(480, 0).x, row_y(i)),
+                       42, i == white_row ? white : amber);
+    }
+    ImGui::PopStyleColor();
+    focus_selection = false;
+
+    const int highlighted = hovered >= 0 ? hovered : selection;
+    const char* label = rows[highlighted];
+    ImFont* font = g_arcade_title_font ? g_arcade_title_font : ImGui::GetFont();
+    const float label_width = font->CalcTextSizeA(42 * scale, FLT_MAX, 0.0f, label).x / scale;
+    const float star_x = 480 - label_width * 0.5f - 48;
+    const float star_y = (row_y(highlighted) - canvas.origin.y) / scale - 14;
+    static const unsigned char star[] = {0x41, 0x22, 0x14, 0x7f, 0x14, 0x22, 0x41};
+    for (int row = 0; row < 7; ++row)
+        for (int col = 0; col < 7; ++col)
+            if (star[row] & (0x40 >> col))
+                canvas.rect(star_x + static_cast<float>(col) * 4, star_y + static_cast<float>(row) * 4, 4, 4, white);
