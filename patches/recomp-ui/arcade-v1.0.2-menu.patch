+float arcade_value_width() {
+    return std::min(ImGui::GetContentRegionAvail().x * 0.46f, px(238));
+}
+
+bool arcade_toggle_row(const char* label, const LauncherTheme& th, const char* id,
+                       bool value, bool retro) {
+    const float width = retro ? arcade_value_width() : ImGui::GetFrameHeight();
+    row_label_right(label, th, width);
+    if (!retro) return ImGui::Checkbox(id, &value);
+    ImGui::PushID(id);
+    const bool pressed = ImGui::Button(value ? "SÍ###toggle" : "NO###toggle", ImVec2(width, 0));
+    ImGui::PopID();
+    return pressed;
+}
