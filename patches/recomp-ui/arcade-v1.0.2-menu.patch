+
+    void rect(float x, float y, float w, float h, ImU32 color) const {
+        draw->AddRectFilled(point(x, y), point(x + w, y + h), color);
+    }
+
+    float text(const char *label, float x, float y, float size, ImU32 color,
+               float align = 0.5f, float limit = 770.0f) const {
+        float pixels = size * scale;
+        ImVec2 bounds = font->CalcTextSizeA(pixels, FLT_MAX, 0, label);
+        const float max_width = limit * scale;
+        if (bounds.x > max_width) {
+            pixels *= max_width / bounds.x;
+            bounds = font->CalcTextSizeA(pixels, FLT_MAX, 0, label);
+        }
+        const ImVec2 anchor = point(x, y);
+        draw->AddText(font, pixels,
+            ImVec2(std::round(anchor.x - bounds.x * align), std::round(anchor.y - bounds.y * 0.5f)),
+            color, label);
+        return x - bounds.x * align / scale;
+    }
+
+    void cursor(float left, float y) const {
+        static const unsigned char star[] = {0x41, 0x22, 0x14, 0x7f, 0x14, 0x22, 0x41};
+        for (int row = 0; row < 7; ++row)
+            for (int column = 0; column < 7; ++column)
+                if (star[row] & (0x40 >> column))
+                    rect(left + static_cast<float>(column) * 4.0f,
+                         y - 14.0f + static_cast<float>(row) * 4.0f, 4.0f, 4.0f, pause_white);
+    }
+};
+
+void pause_uppercase(char *text) {
+    for (unsigned char *c = reinterpret_cast<unsigned char *>(text); *c; ++c) {
+        if (*c == 0xc3 && (c[1] == 0xa1 || c[1] == 0xa9 || c[1] == 0xad ||
+                          c[1] == 0xb1 || c[1] == 0xb3 || c[1] == 0xba || c[1] == 0xbc)) {
+            ++c;
+            *c = static_cast<unsigned char>(*c - 0x20);
+        } else if (*c >= 'a' && *c <= 'z') {
+            *c = static_cast<unsigned char>(*c - ('a' - 'A'));
+        }
+    }
+}
+
+void draw_arcade_pause(RecompRuntimeUi *ui, LauncherTheme &theme, ImVec2 display,
+                       ImVec2 viewport_origin, ImVec2 viewport_size) {
+    // Leaving the only section with Back resumes the game.
+    if (!ui->in_section) {
+        recomp_runtime_ui_close(ui);
+        return;
+    }
+    const float scale = std::min(viewport_size.x / 1148.0f, viewport_size.y / 1080.0f);
+    const ImVec2 center(viewport_origin.x + viewport_size.x * 0.5f,
+                        viewport_origin.y + viewport_size.y * 0.5f);
+    theme.background = theme.panel = lng_rgba(0, 0, 0, 1);
+    theme.text = theme.border = lng_rgba(1, 1, 1, 1);
+    theme.accent = theme.accent2 = lng_rgba(1.0f, 0.69f, 0.17f, 1.0f);
+    theme.accent_dim = lng_rgba(0.38f, 0.24f, 0.06f, 1);
+    theme.control = lng_rgba(0.12f, 0.08f, 0.02f, 1);
+    theme.control_hovered = theme.panel_hovered = lng_rgba(0.26f, 0.17f, 0.05f, 1);
+    theme.text_muted = lng_rgba(0.65f, 0.58f, 0.47f, 1);
+    theme.radius_sm = theme.radius_lg = 0.0f;
+    push_runtime_style(theme, false, 1.0f);
+
+    ImGui::SetNextWindowPos(ImVec2(0, 0), ImGuiCond_Always);
+    ImGui::SetNextWindowSize(display, ImGuiCond_Always);
+    const ImGuiWindowFlags flags = ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove |
+        ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoBackground | ImGuiWindowFlags_NoInputs;
+    if (ImGui::Begin("##arcade-pause", nullptr, flags)) {
+        ImFont *font = ImGui::GetFont();
+        for (ImFont *candidate : ImGui::GetIO().Fonts->Fonts)
+            if (!std::strcmp(candidate->GetDebugName(), "Arcade Pause")) {
+                font = candidate;
+                break;
+            }
+        const PauseCanvas canvas{ImGui::GetWindowDrawList(), font, center, scale};
+        // The frozen stage stays visible on all four sides of the panel.
+        canvas.rect(-454.0f, 102.0f, 908.0f, 876.0f, pause_white);
+        canvas.rect(-449.0f, 107.0f, 898.0f, 866.0f, IM_COL32_BLACK);
+        canvas.text("PAUSA", 0.0f, 152.0f, 92.0f, pause_white);
+
+        const bool root = ui->page_depth == 0;
+        const bool categories = ui->page_depth == 1;
+        const size_t count = recomp_runtime_ui_page_entry_count(ui);
+        const size_t visible_count = std::min(size_t{8}, count);
+        const size_t first = visible_count && count > visible_count
+            ? std::min(count - visible_count, ui->row_index > 3 ? ui->row_index - 3 : 0) : 0;
+        if (!root && !categories) {
+            const char *last = std::strrchr(ui->page, '/');
+            char name[96];
+            std::snprintf(name, sizeof(name), "%s", last ? last + 1 : ui->page);
+            pause_uppercase(name);
+            canvas.text(name, 0.0f, 250.0f, 40.0f, pause_white);
+        }
+
+        const float pitch = std::max(1.0f, std::round(72.0f * scale));
+        const float first_y = std::round(
+            center.y - (static_cast<float>(visible_count) - 1.0f) * pitch * 0.5f);
+        for (size_t index = 0; index < visible_count; ++index) {
+            const size_t row = first + index;
+            char folder[96];
+            const RecompRuntimeUiItem *item = recomp_runtime_ui_page_entry(
+                ui, row, folder, sizeof(folder));
+            const char *label = item ? item->label : folder;
+            if (!label || !*label) continue;
+            const bool enabled = !item || recomp_runtime_ui_item_enabled(ui, item) != 0;
+            const ImU32 color = enabled ? pause_amber : pause_muted;
+            const float y = 540.0f + (first_y + static_cast<float>(index) * pitch - center.y) / scale;
+            char name[160];
+            std::snprintf(name, sizeof(name), "%s", label);
+            pause_uppercase(name);
+
+            float left;
+            if (item && (item->type == RECOMP_RUNTIME_UI_BOOL ||
+                         item->type == RECOMP_RUNTIME_UI_CHOICE ||
+                         item->type == RECOMP_RUNTIME_UI_INT)) {
+                char value[96];
+                value_text(ui, item, value, sizeof(value));
+                pause_uppercase(value);
+                char display_value[104];
+                std::snprintf(display_value, sizeof(display_value), "< %s >", value);
+                left = canvas.text(name, -350.0f, y, 38.0f, color, 0.0f, 430.0f);
+                canvas.text(display_value, 350.0f, y, 38.0f,
+                            enabled ? pause_white : pause_muted, 1.0f, 245.0f);
+            } else {
+                left = canvas.text(name, 0.0f, y, root ? 64.0f : categories ? 70.0f : 38.0f, color);
+            }
+            if (row == ui->row_index) canvas.cursor(left - 47.0f, y);
+        }
+
+        if (ui->status_frames) {
+            const char *status = ui->status;
+            if (!std::strcmp(status, "Done")) status = "";
+            else if (!std::strcmp(status, "Saved")) status = "GUARDADO";
+            canvas.text(status, 0.0f, 896.0f, 25.0f, pause_white);
+            recomp_runtime_ui_advance_status(ui, ImGui::GetIO().DeltaTime * 60.0f);
+        } else if (!root && !categories) {
+            canvas.text("ENTER / A     |     ESC / B", 0.0f, 894.0f, 24.0f, pause_muted);
+        }
+    }
+    ImGui::End();
+    draw_color_editor(ui, theme, center, ImVec2(908.0f * scale, 876.0f * scale));
+    pop_runtime_style();
+}
