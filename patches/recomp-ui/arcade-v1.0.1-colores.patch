--- /dev/null
+++ b/src/common/launcher_host_capture.h
@@ -0,0 +1,95 @@
+/* Host-owned bindings: SDL events -> the same settings displayed by the UI.
+ * Kept independent of ImGui so the shipping event path is regression tested. */
+#ifndef LAUNCHER_HOST_CAPTURE_H
+#define LAUNCHER_HOST_CAPTURE_H
+#include "launcher_model.h"
+#include "launcher_input.h"
+#include "launcher_sdlcompat.h"
+#include <stdio.h>
+#include <string.h>
+
+/* Match the host's preferred-GUID/first-free assignment after every hotplug.
+ * SDL2 instance 0 is valid; instance+1 is our explicit connected marker. */
+static inline void launcher_host_refresh_pads(LauncherModel *m, const LauncherPad *pads, int count) {
+    if (!m->settings_bindings) return;
+    int used[LNG_MAX_PADS]={0}, assigned[LNG_MAX_PLAYERS];
+    int players=m->player_count<2?2:m->player_count;
+    if (players>LNG_MAX_PLAYERS) players=LNG_MAX_PLAYERS;
+    if (count>LNG_MAX_PADS) count=LNG_MAX_PADS;
+    for (int p=0;p<players;++p) assigned[p]=-1;
+    for (int p=0;p<players;++p) {
+        if (m->s.player_src[p]!=2 || !m->s.player_gamepad_guid[p][0]) continue;
+        for (int i=0;i<count;++i) if (!used[i] && !strcmp(pads[i].guid,m->s.player_gamepad_guid[p])) {
+            assigned[p]=i; used[i]=1; break;
+        }
+    }
+    if (m->s.player_src[0]==1)
+        for (int i=0;i<count;++i) if (!used[i]) {assigned[0]=i; used[i]=1; break;}
+    for (int p=0;p<players;++p) if (m->s.player_src[p]==2 && assigned[p]<0)
+        for (int i=0;i<count;++i) if (!used[i]) {assigned[p]=i; used[i]=1; break;}
+    for (int p=0;p<players;++p) {
+        int i=assigned[p];
+        m->player_pad_id[p]=i<0?0:pads[i].id;
+        m->s.player_gamepad_instance[p]=i<0?0:pads[i].id+1;
+        snprintf(m->player_pad_name[p],sizeof m->player_pad_name[p],"%s",i<0?"":pads[i].name);
+    }
+}
+
+static inline int launcher_host_capture_event(LauncherModel *m, const SDL_Event *ev) {
+    if (!m->settings_bindings || !m->capturing) return 0;
+    if (ev->type == SDL_EVENT_KEY_DOWN) {
+        if (LNG_EVKEYREPEAT((*ev))) return 1;
+        if (LNG_EVKEY((*ev)) == SDLK_ESCAPE) {
+            launcher_model_cancel_capture(m); return 1;
+        }
+        if (LNG_EVKEY((*ev)) == SDLK_BACKSPACE) {
+            if (m->capture_pad) launcher_model_set_captured_pad(m,0);
+            else launcher_model_set_captured_key(m,0);
+            launcher_model_cancel_capture(m); return 1;
+        }
+        if (!m->capture_pad) {
+            if (LNG_EVSCAN((*ev)) == SDL_SCANCODE_F2) {
+                snprintf(m->binding_status, sizeof m->binding_status, "F2 esta reservado por el motor. Elige otra tecla.");
+                launcher_model_cancel_capture(m); return 1;
+            }
+            launcher_model_set_captured_key(m,(int)LNG_EVSCAN((*ev)));
+            launcher_model_cancel_capture(m);
+        }
+        return 1;
+    }
+    if (!m->capture_pad) return 1;
+    uint32_t which;
+    if (ev->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN) which=(uint32_t)LNG_EVGBTNWHICH((*ev));
+    else if (ev->type == SDL_EVENT_GAMEPAD_AXIS_MOTION) which=(uint32_t)LNG_EVGAXISWHICH((*ev));
+    else return 1;
+    uint32_t selected=m->player_pad_id[m->cfg_player];
+    if (!m->capture_assist && (!m->s.player_gamepad_instance[m->cfg_player] || selected!=which)) return 1;
+    if (!m->capture_assist && m->map_all_wait_release) {
+        if (launcher_input_gamepad_at_rest(which)) m->map_all_wait_release=false;
+        return 1;
+    }
+    int binding=0;
+    if (ev->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN) {
+        int button=(int)LNG_EVGBTN((*ev));
+        if (button<0 || button>=32) return 1;
+        uint32_t mask=launcher_input_gamepad_button_mask(which) | (1u<<button);
+        if (m->capture_assist && (mask & (mask-1)))
+            binding=RECOMP_LAUNCHER_PAD_BUTTON_COMBO(mask);
+        else if (m->capture_assist) {
+            /* Preserve Select-as-chord-prefix for global host shortcuts. */
+#if defined(LNG_SDL3)
+            if (button==SDL_GAMEPAD_BUTTON_BACK) return 1;
+#else
+            if (button==SDL_CONTROLLER_BUTTON_BACK) return 1;
+#endif
+            binding=launcher_model_assist_pad_button_capture_binding(m,m->capture_btn,button);
+        } else binding=RECOMP_LAUNCHER_PAD_BUTTON(button);
+    } else {
+        int v=(int)LNG_EVGAXISVAL((*ev));
+        if (v<20000 && v>-20000) return 1;
+        binding=RECOMP_LAUNCHER_PAD_AXIS((int)LNG_EVGAXIS((*ev)),v>0);
+    }
+    launcher_model_set_captured_pad(m,binding);
+    launcher_model_cancel_capture(m); return 1;
+}
