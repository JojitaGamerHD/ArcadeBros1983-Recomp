+void draw_color_preview(RecompRuntimeUi *ui,const RecompRuntimeUiItem *item,float box) {
+    RecompRuntimeUiColorPreview preview{};
+    const bool available = ui->config.callbacks.get_color_preview &&
+        ui->config.callbacks.get_color_preview(ui->config.callbacks.context,item,&preview) &&
+        preview.width>0 && preview.height>0 &&
+        preview.width<=RECOMP_RUNTIME_UI_PREVIEW_MAX && preview.height<=RECOMP_RUNTIME_UI_PREVIEW_MAX;
+    ImGui::TextUnformatted("Vista previa del personaje");
+    const ImVec2 top=ImGui::GetCursorScreenPos();
+    ImDrawList *draw=ImGui::GetWindowDrawList();
+    const float tile=16.0f;
+    for (float y=0;y<box;y+=tile) for (float x=0;x<box;x+=tile) {
+        const bool odd=(int(x/tile)+int(y/tile))&1;
+        draw->AddRectFilled(ImVec2(top.x+x,top.y+y),
+            ImVec2(top.x+std::min(box,x+tile),top.y+std::min(box,y+tile)),
+            odd?IM_COL32(30,35,46,255):IM_COL32(19,23,32,255));
+    }
+    if (available) {
+        const float scale=std::max(1.0f,std::floor(std::min(box/preview.width,box/preview.height)));
+        const ImVec2 origin(std::floor(top.x+(box-preview.width*scale)*0.5f),
+                            std::floor(top.y+(box-preview.height*scale)*0.5f));
+        for (int y=0;y<preview.height;++y) for (int x=0;x<preview.width;++x) {
+            const unsigned index=preview.pixels[y*preview.width+x];
+            if (!index || index>3) continue;
+            draw->AddRectFilled(ImVec2(origin.x+x*scale,origin.y+y*scale),
+                ImVec2(origin.x+(x+1)*scale,origin.y+(y+1)*scale),preview_rgb(preview.palette[index-1]));
+        }
+    }
+    draw->AddRect(top,ImVec2(top.x+box,top.y+box),IM_COL32(85,125,155,255));
+    ImGui::Dummy(ImVec2(box,box));
+    if (available) {
+        for (int i=0;i<3;++i) {
+            if (i) ImGui::SameLine();
+            ImGui::PushID(i);
+            ImVec4 color=ImGui::ColorConvertU32ToFloat4(preview_rgb(preview.palette[i]));
+            ImGui::ColorButton("##palette",color,ImGuiColorEditFlags_NoTooltip,ImVec2(28,22));
+            ImGui::PopID();
+        }
+        ImGui::TextWrapped("La vista previa usa el sprite de tu partida.");
+    } else {
+        ImGui::TextWrapped("Entra en una partida con este personaje para ver su sprite aqui.");
+    }
+}
