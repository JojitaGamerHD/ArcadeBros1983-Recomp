+/* Keyboard is shared; pads are independently assigned. Shortcuts consume
+ * input before gameplay, so reject overlapping assignments explicitly. */
+static bool binding_overlap(int a, int b, bool pad) {
+    if (!a || !b) return false;
+    if (!pad || a == b) return a == b;
+    unsigned am = a > 1000 ? (unsigned)(a - 1000) :
+                  a >= 1 && a <= 32 ? 1u << (a - 1) : 0;
+    unsigned bm = b > 1000 ? (unsigned)(b - 1000) :
+                  b >= 1 && b <= 32 ? 1u << (b - 1) : 0;
+    return (am & bm) != 0;
+}
+static bool host_binding_available(LauncherModel* m, int value, bool pad) {
