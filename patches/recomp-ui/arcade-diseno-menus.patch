diff --git a/src/common/arcade_frame.h b/src/common/arcade_frame.h
new file mode 100644
index 0000000..a00d2e0
--- /dev/null
+++ b/src/common/arcade_frame.h
@@ -0,0 +1,72 @@
+#ifndef ARCADE_FRAME_H
+#define ARCADE_FRAME_H
+
+#include <stdint.h>
+
+typedef struct ArcadeRect {
+    int x, y, w, h;
+} ArcadeRect;
+
+typedef struct ArcadeFrame {
+    ArcadeRect outer;
+    ArcadeRect inner;
+    int border;
+} ArcadeFrame;
+
+static inline ArcadeRect arcade_fit_picture(ArcadeRect area, int w, int h, int integer_scale)
+{
+    ArcadeRect result = {area.x, area.y, 0, 0};
+    if (area.w <= 0 || area.h <= 0 || w <= 0 || h <= 0) return result;
+
+    const int wide = (int64_t)area.w * h > (int64_t)area.h * w;
+    const int whole = wide ? area.h / h : area.w / w;
+    if (integer_scale && whole >= 1) {
+        result.w = w * whole;
+        result.h = h * whole;
+    } else if (wide) {
+        result.w = (int)((int64_t)area.h * w / h);
+        result.h = area.h;
+    } else {
+        result.w = area.w;
+        result.h = (int)((int64_t)area.w * h / w);
+    }
+    if (result.w < 1) result.w = 1;
+    if (result.h < 1) result.h = 1;
+    result.x += (area.w - result.w) / 2;
+    result.y += (area.h - result.h) / 2;
+    return result;
+}
+
+static inline ArcadeFrame arcade_frame_layout(int w, int h)
+{
+    const ArcadeRect drawable = {0, 0, w, h};
+    ArcadeFrame frame = {0};
+    frame.outer = arcade_fit_picture(drawable, 256, 240, 0);
+    const int shorter = frame.outer.w < frame.outer.h ? frame.outer.w : frame.outer.h;
+    if (shorter > 2) {
+        frame.border = (int)(((int64_t)frame.outer.h + 45) / 90);
+        if (frame.border < 1) frame.border = 1;
+        if (frame.border > (shorter - 1) / 2) frame.border = (shorter - 1) / 2;
+    }
+    frame.inner.x = frame.outer.x + frame.border;
+    frame.inner.y = frame.outer.y + frame.border;
+    frame.inner.w = frame.outer.w - 2 * frame.border;
+    frame.inner.h = frame.outer.h - 2 * frame.border;
+    return frame;
+}
+
+static inline void arcade_frame_edges(ArcadeFrame frame, ArcadeRect edges[4])
+{
+    const ArcadeRect outer = frame.outer, inner = frame.inner;
+    const int t = frame.border;
+    const ArcadeRect top = {outer.x, outer.y, outer.w, t};
+    const ArcadeRect bottom = {outer.x, inner.y + inner.h, outer.w, t};
+    const ArcadeRect left = {outer.x, inner.y, t, inner.h};
+    const ArcadeRect right = {inner.x + inner.w, inner.y, t, inner.h};
+    edges[0] = top;
+    edges[1] = bottom;
+    edges[2] = left;
+    edges[3] = right;
+}
+
+#endif
diff --git a/src/common/backends/imgui/arcade_menu_canvas.h b/src/common/backends/imgui/arcade_menu_canvas.h
new file mode 100644
index 0000000..a34f257
--- /dev/null
+++ b/src/common/backends/imgui/arcade_menu_canvas.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include "imgui.h"
+
+#include <algorithm>
+#include <cfloat>
+#include <cmath>
+#include <string>
+
+inline std::string arcade_menu_letters(const char* label) {
+    std::string text;
+    for (const auto* letter = reinterpret_cast<const unsigned char*>(label); *letter; ++letter) {
+        if (*letter == 0xc3) {
+            switch (letter[1]) {
+                case 0x81: case 0xa1: text += 'A'; ++letter; continue;
+                case 0x89: case 0xa9: text += 'E'; ++letter; continue;
+                case 0x8d: case 0xad: text += 'I'; ++letter; continue;
+                case 0x93: case 0xb3: text += 'O'; ++letter; continue;
+                case 0x9a: case 0xba: text += 'U'; ++letter; continue;
+                default: break;
+            }
+        }
+        text += static_cast<char>(*letter >= 'a' && *letter <= 'z' ? *letter - ('a' - 'A') : *letter);
+    }
+    return text;
+}
+
+struct ArcadeMenuCanvas {
+    static constexpr float width = 960.0f;
+    static constexpr float height = 900.0f;
+    static constexpr float middle = width / 2;
+    static constexpr float body = 32.0f;
+    static constexpr float row = 32.0f;
+    static constexpr float gap = 38.0f;
+    static constexpr ImU32 white = IM_COL32_WHITE;
+    static constexpr float cursor_width = 28.0f;
+    static constexpr float cursor_gap = 14.0f;
+
+    ImVec2 origin;
+    float scale;
+    ImDrawList* draw;
+    ImFont* font;
+
+    static float fit(ImVec2 size) {
+        return std::min(size.x / width, size.y / height);
+    }
+
+    static ArcadeMenuCanvas inside(ImVec2 min, ImVec2 size, ImDrawList* draw, ImFont* font) {
+        const float scale = fit(size);
+        return {{min.x + (size.x - width * scale) / 2,
+                 min.y + (size.y - height * scale) / 2}, scale, draw, font};
+    }
+
+    ImVec2 point(float x, float y) const {
+        return ImVec2(origin.x + x * scale, origin.y + y * scale);
+    }
+
+    void rect(float x, float y, float w, float h, ImU32 color) const {
+        draw->AddRectFilled(point(x, y), point(x + w, y + h), color);
+    }
+
+    void cursor(float text_left, float y) const {
+        constexpr float widths[] = {7, 14, 21, cursor_width, 21, 14, 7};
+        constexpr float step = 3.5f;
+        const float x = text_left - cursor_width - cursor_gap;
+        const float top = y + 1 - step * 3.5f;
+        for (int i = 0; i < 7; ++i)
+            rect(x, top + i * step, widths[i], step, white);
+    }
+
+    void swatch(float x, float y, ImU32 color) const {
+        rect(x, y - 8, 16, 16, white);
+        rect(x + 2, y - 6, 12, 12, color);
+    }
+
+    float text(const char* label, float x, float y, ImU32 color = white,
+               float align = 0.5f, float size = body) const {
+        const std::string letters = arcade_menu_letters(label);
+        const float pixels = size * scale;
+        const ImVec2 bounds = font->CalcTextSizeA(pixels, FLT_MAX, 0, letters.c_str());
+        const ImVec2 anchor = point(x, y);
+        const ImVec2 density = ImGui::GetIO().DisplayFramebufferScale;
+        const float left = std::round((anchor.x - bounds.x * align) * density.x) / density.x;
+        const float top = std::round((anchor.y - bounds.y * 0.5f) * density.y) / density.y;
+        draw->AddText(font, pixels, ImVec2(left, top), color, letters.c_str());
+        return x - bounds.x * align / scale;
+    }
+
+    void choice(const char* label, float x, float y, bool selected, float align = 0.5f) const {
+        const float left = text(label, x, y, white, align);
+        if (selected) cursor(left, y);
+    }
+};
