+        const auto line = text.substr(0, end);
+        if (!line.empty())
+            canvas.text(std::string(line).c_str(), canvas.middle, y);
+        y += canvas.row;
+        if (end == std::string_view::npos) break;
+        text.remove_prefix(end + 1);
+    }
+}
