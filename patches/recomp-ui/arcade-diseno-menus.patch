+void draw_arcade_notice(const ArcadeTitleCanvas& canvas, const char* message) {
+    if (!message) return;
+    const char* end = message + std::strlen(message);
+    const float size = canvas.body * canvas.scale;
+    if (canvas.font->CalcTextSizeA(size, FLT_MAX, 0, message).x <= 890 * canvas.scale) {
+        canvas.text(message, canvas.middle, 862);
+        return;
+    }
+    const char* split = message + (end - message) / 2;
+    while (*split != ' ' && split > message) --split;
+    if (split == message) return;
+    canvas.text(std::string(message, split).c_str(), canvas.middle, 830);
+    canvas.text(split + 1, canvas.middle, 862);
+}
