+std::string arcade_binding_cell(std::string name, size_t cells) {
+    std::transform(name.begin(), name.end(), name.begin(), [](unsigned char ch) {
+        return static_cast<char>(std::toupper(ch));
+    });
+    if (name.size() > cells) {
+        size_t end = cells - 1;
+        while (end > 0 && (static_cast<unsigned char>(name[end]) & 0xc0) == 0x80) --end;
+        name.resize(end);
+        name += "…";
     }
+    return name;
+}
 
+void draw_arcade_bindings(LauncherModel* m, ArcadeOptionsRows& rows) {
+    static const char* const names[] = {"UP:", "DOWN:", "LEFT:", "RIGHT:", "A:", "B:", "START:", "SELECT:"};
+    static const int order[4][2] = {{0, 2}, {1, 3}, {4, 6}, {5, 7}};
+    static const int capture_order[] = {0, 1, 4, 5, 2, 3, 6, 7};
+    const int player = m->cfg_player;
+    const bool pad = m->s.player_src[player] == 2;
+    if (s_automap_i >= 0 && s_automap_player == player) {
+        if (m->binding_status[0] || s_automap_i == IM_ARRAYSIZE(capture_order)) {
+            s_automap_i = s_automap_player = -1;
+        } else if (!m->capturing &&
+                   (!pad || !m->player_pad_id[player] ||
+                    launcher_input_gamepad_at_rest(m->player_pad_id[player]))) {
+            const int button = capture_order[s_automap_i++];
+            if (pad) launcher_model_begin_pad_capture(m, button);
+            else launcher_model_begin_capture(m, button);
+        }
+    }
+    for (int i = 0; i < 4; ++i) {
+        const float y = arcade_first_row + i * rows.canvas.row;
+        for (int column = 0; column < 2; ++column) {
+            const int button = order[i][column];
+            const float left = column == 0 ? 80.0f : 500.0f;
+            const float label_x = column == 0 ? 294.0f : 720.0f;
+            const bool capture = m->capturing && !m->capture_assist && m->capture_btn == button;
+            if (rows.item(names[button], y, true, left, column == 0 ? 500.0f : 924.0f)) {
+                if (pad) launcher_model_begin_pad_capture(m, button);
+                else launcher_model_begin_capture(m, button);
+            }
+            const auto value = arcade_binding_cell(capture ? "..." :
+                pad ? arcade_pad_name(m->s.player_pad_bind[player][button]) :
+                      arcade_key_name(m->s.player_key_bind[player][button]), column == 0 ? 5 : 7);
+            rows.canvas.choice(names[button], label_x, y, rows.selected, 1);
+            rows.canvas.text(value.c_str(), label_x + 11, y, rows.canvas.white, 0);
+        }
+    }
+    if (rows.action("RESTABLECER", arcade_first_row + 4 * rows.canvas.row + rows.canvas.gap))
+        launcher_model_reset_player_bindings(m, player);
+    if (rows.allow_input && rows.selected && s_automap_i < 0) {
+        if (ImGui::IsKeyPressed(ImGuiKey_F2, false) ||
+            ImGui::IsKeyPressed(ImGuiKey_GamepadFaceLeft, false)) {
+            s_automap_i = 0;
+            s_automap_player = player;
+            m->binding_status[0] = 0;
+        } else if (!m->binding_status[0]) {
+            draw_arcade_notice(rows.canvas, "F2 / X: ASIGNAR TODOS");
+        }
+    }
+}
+
+void draw_arcade_shortcuts(LauncherModel* m, ArcadeOptionsRows& rows) {
+    constexpr float action_x = 82, keyboard_x = 535, separator_x = 670, pad_x = 821;
+    rows.canvas.text("ACCIÓN", action_x, arcade_first_row, rows.canvas.white, 0);
+    rows.canvas.text("TECLADO", keyboard_x, arcade_first_row);
+    rows.canvas.text("-", separator_x, arcade_first_row);
+    rows.canvas.text("MANDO", pad_x, arcade_first_row);
+    static const char* const labels[] = {"MENÚ:", "FULLSCREEN:"};
+    for (int i = 0; i < std::min(m->assist_binding_count, IM_ARRAYSIZE(labels)); ++i) {
+        const float y = arcade_first_row + rows.canvas.gap + (i + 1) * rows.canvas.row;
+        rows.canvas.text(labels[i], action_x, y, rows.canvas.white, 0);
+        rows.canvas.text("-", separator_x, y);
+        ImGui::PushID(i);
+        for (int pad = 0; pad < 2; ++pad) {
+            const float x = pad ? pad_x : keyboard_x;
+            const bool capture = m->capturing && m->capture_assist && m->capture_btn == i &&
+                                 m->capture_pad == (pad != 0);
+            if (rows.item(pad ? "##mando" : "##teclado", y, true, x - 90, x + 90))
+                launcher_model_begin_assist_capture(m, i, pad != 0);
+            const auto value = arcade_binding_cell(capture ? "..." :
+                pad ? arcade_pad_name(m->s.assist_pad_bind[i]) : arcade_key_name(m->s.assist_key_bind[i]), 6);
+            rows.canvas.choice(value.c_str(), x, y, rows.selected);
+        }
+        ImGui::PopID();
+    }
+    if (rows.action("RESTABLECER", arcade_first_row + 3 * rows.canvas.row + 2 * rows.canvas.gap))
+        launcher_model_reset_assist_bindings(m);
+}
